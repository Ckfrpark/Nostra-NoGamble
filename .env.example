# PostgreSQL. 없으면 data/alal.db (SQLite)를 쓴다 — 로컬 개발용.
DATABASE_URL=
# 운영 화면(/#/admin) 토큰. 길고 무작위로.
ADMIN_TOKEN=
# 올공 회원 id를 해시할 비밀값. 32자 이상, 한 번 정하면 바꾸지 않는다(바꾸면 모두 새 계정이 된다).
IDENTITY_SECRET=
# 이 서비스의 주소 (올공 로그인 후 돌아올 주소를 만든다). 예: https://nogamble.olgong.xyz
PUBLIC_BASE_URL=
# 올공나라 회원 Supabase 프로젝트 주소와 공개 키 (NOSTRA와 같은 값)
OLGONG_SUPABASE_URL=
OLGONG_SUPABASE_KEY=
# 올공나라 사이트에서 바로 넘어오는 로그인 폼의 출처 (기본 https://olgong.xyz)
OLGONG_PORTAL_ORIGIN=https://olgong.xyz
# 로컬 개발에서만 1: 휴대폰 번호로 들어가는 개발용 로그인. 운영(NODE_ENV=production)에서는 켜면 서버가 시작하지 않는다.
ALLOW_DEV_LOGIN=
